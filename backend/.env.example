# Email Configuration (for contact form notifications)
# Note: For Gmail, you MUST use an "App Password", not your regular password.
# See: https://support.google.com/accounts/answer/185833
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# MongoDB Configuration (Backend Database)
# Get this from your MongoDB Atlas cluster: https://www.mongodb.com/atlas/database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Cloudinary Configuration (for image uploads in admin panel)
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin Authentication
ADMIN_PASSWORD="your-secure-admin-password"
JWT_SECRET="your-random-secret-key-here-minimum-32-characters"

# Backend URL
# This is the public URL where your backend is deployed (Render)
BACKEND_URL=https://webhub-08uf.onrender.com

# API URL for Frontend to connect to backend
# This should be the Render URL where your backend is deployed
VITE_API_URL=https://webhub-08uf.onrender.com

# Server Port (Render automatically sets this, override for local dev)
PORT=3000